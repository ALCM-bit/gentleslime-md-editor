# https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

# Markdown is content: trailing spaces can be hard line breaks.
[*.md]
max_line_length = off
trim_trailing_whitespace = false
